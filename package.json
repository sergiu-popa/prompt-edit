{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write resources/js tests/js tests/e2e",
        "format:check": "prettier --check resources/js tests/js tests/e2e",
        "types": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^3.11.0",
        "@playwright/test": "1.65.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.20.5",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.6.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.1",
        "jsdom": "^31.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.1.1",
        "vue": "^3.5.45",
        "vue-tsc": "^3.3.14"
    }
}

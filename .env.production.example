# Production .env for https://prompt.sergiupopa.dev (HestiaCP, user admin).
# Lives in /home/admin/web/prompt.sergiupopa.dev/shared/.env (chmod 600), shared by every release (README, "Production").
# Secrets are blank here and generated on the server; they are never committed.

APP_NAME=PromptEdit
APP_ENV=production
# Generated once on the server: "base64:" + `openssl rand -base64 32`. Changing it signs everyone out.
APP_KEY=
APP_DEBUG=false
APP_URL=https://prompt.sergiupopa.dev
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One file per day in shared/storage/logs, kept 14 days. `info` keeps the app:upsert-user line.
# The stack also sends error-level lines to Sentry once SENTRY_LARAVEL_DSN is set (D-77).
LOG_CHANNEL=stack
LOG_STACK=daily,sentry
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL 17 on the droplet, localhost only, with its own prompt_edit role.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=prompt_edit
DB_USERNAME=prompt_edit
# Generated with `openssl rand -hex 24` when the role is created, and written here without echoing.
DB_PASSWORD=
# Where app:backup-database writes the nightly pg_dump files (D-22). Hestia's backup of admin carries them.
DB_BACKUP_PATH=/home/admin/web/prompt.sergiupopa.dev/private/backups

# Sessions on the database (D-20). The cookie is only ever sent over HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue and cache on the database too: no Redis on the droplet (D-20).
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail is not used.
MAIL_MAILER=log

INERTIA_SSR_ENABLED=false
VITE_APP_NAME="${APP_NAME}"

# Pixelforge: the real API (the fake is refused in production). Every other setting keeps its default.
PIXELFORGE_DRIVER=http
# Production's own dedicated key, never the dev key: usage and the webhook URL are per key.
PIXELFORGE_API_KEY=
# The whsec_… signing secret of that same key, from its webhook settings in the dashboard.
PIXELFORGE_WEBHOOK_SECRET=

# Sentry error monitoring (D-77): reported exceptions and error-level log lines, with no request
# bodies, cookies, user emails or IPs, and secrets filtered. The project's DSN is written here on
# the server; empty sends nothing. Every other Sentry setting keeps its default: tracing stays off.
SENTRY_LARAVEL_DSN=

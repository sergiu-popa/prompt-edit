APP_NAME="PromptEdit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://prompt-edit.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=prompt_edit
DB_USERNAME=prompt_edit
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pixelforge: filled by `make setup` with a random local value; put a real key's whsec_… here only to receive real webhooks. Never committed
PIXELFORGE_WEBHOOK_SECRET=

# Pixelforge: the dev key, never committed; empty settings use the defaults
PIXELFORGE_API_KEY=
PIXELFORGE_DRIVER=fake
PIXELFORGE_BASE_URL=
PIXELFORGE_CONNECT_TIMEOUT=
PIXELFORGE_REQUEST_TIMEOUT=

# Pixelforge fake (PIXELFORGE_DRIVER=fake): empty settings use the defaults
PIXELFORGE_FAKE_WEBHOOK_URL=http://app:8080
PIXELFORGE_FAKE_QUEUE_SECONDS=
PIXELFORGE_FAKE_PROCESSING_SECONDS=
PIXELFORGE_FAKE_SLOW_SECONDS=
PIXELFORGE_FAKE_IMAGE_TTL_SECONDS=
PIXELFORGE_FAKE_EXPIRE_TTL_SECONDS=
PIXELFORGE_FAKE_CHAOS_PERCENT=

# Generate submissions per user per minute; empty uses the default (10)
GENERATION_SUBMISSIONS_PER_MINUTE=

# No SSR bundle in this project; stops Inertia posting to the Vite dev server in hot mode
INERTIA_SSR_ENABLED=false

# Docker
WWWUSER=1000
WWWGROUP=1000
XDEBUG_MODE=off
VITE_PORT=5173
ENABLE_NPM_FRONTEND=true

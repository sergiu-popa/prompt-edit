<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!-- The live smoke talks to the real Pixelforge with a dev key; only `make live-smoke` runs it (D-58). -->
    <groups>
        <exclude>
            <group>live</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="test-postgres"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="prompt_edit_test"/>
        <env name="DB_USERNAME" value="prompt_edit"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="AUTH_REGISTRATIONS_PER_HOUR" value="" force="true"/>
        <env name="CREDITS_STARTER_GRANT" value="" force="true"/>
        <env name="PIXELFORGE_API_KEY" value="" force="true"/>
        <env name="PIXELFORGE_DRIVER" value="http" force="true"/>
        <env name="PIXELFORGE_WEBHOOK_SECRET" value="" force="true"/>
        <env name="PIXELFORGE_RATE_LIMIT_PER_MINUTE" value="" force="true"/>
        <env name="PIXELFORGE_OVERLOADED_DEADLINE" value="" force="true"/>
        <env name="PIXELFORGE_FAKE_DROP_WEBHOOKS" value="" force="true"/>
        <env name="PIXELFORGE_RECONCILE_QUEUED_AFTER" value="" force="true"/>
        <env name="PIXELFORGE_RECONCILE_PROCESSING_AFTER" value="" force="true"/>
        <env name="PIXELFORGE_RECONCILE_RECHECK" value="" force="true"/>
        <env name="PIXELFORGE_RECONCILE_RECHECK_MAX" value="" force="true"/>
        <env name="PIXELFORGE_RECONCILE_BATCH" value="" force="true"/>
        <env name="PIXELFORGE_SUBMIT_RESERVE" value="" force="true"/>
        <env name="PIXELFORGE_RECONCILE_EVERY" value="" force="true"/>
        <env name="PIXELFORGE_REDISPATCH_AFTER" value="" force="true"/>
        <env name="PIXELFORGE_GIVE_UP_AFTER" value="" force="true"/>
        <env name="PIXELFORGE_STUCK_AFTER" value="" force="true"/>
        <!-- The dev containers set these in the process env, which Laravel reads from $_SERVER first. -->
        <server name="AUTH_REGISTRATIONS_PER_HOUR" value=""/>
        <server name="CREDITS_STARTER_GRANT" value=""/>
        <server name="PIXELFORGE_RATE_LIMIT_PER_MINUTE" value=""/>
        <server name="PIXELFORGE_OVERLOADED_DEADLINE" value=""/>
        <server name="PIXELFORGE_FAKE_DROP_WEBHOOKS" value=""/>
        <server name="PIXELFORGE_RECONCILE_QUEUED_AFTER" value=""/>
        <server name="PIXELFORGE_RECONCILE_PROCESSING_AFTER" value=""/>
        <server name="PIXELFORGE_RECONCILE_RECHECK" value=""/>
        <server name="PIXELFORGE_RECONCILE_RECHECK_MAX" value=""/>
        <server name="PIXELFORGE_RECONCILE_BATCH" value=""/>
        <server name="PIXELFORGE_SUBMIT_RESERVE" value=""/>
        <server name="PIXELFORGE_RECONCILE_EVERY" value=""/>
        <server name="PIXELFORGE_REDISPATCH_AFTER" value=""/>
        <server name="PIXELFORGE_GIVE_UP_AFTER" value=""/>
        <server name="PIXELFORGE_STUCK_AFTER" value=""/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
